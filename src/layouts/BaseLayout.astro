---
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import { site, type LangCode } from '../data/site';
import '../assets/styles/main.scss';

interface Props {
  title: string;
  description?: string;
  lang?: LangCode;
  isFront?: boolean;
  nodeType?: string;
  ogType?: string;
  schema?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  lang = 'en',
  isFront = false,
  nodeType,
  ogType = 'website',
  schema,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);

const bodyClasses = [
  'no-sidebar',
  isFront ? 'frontpage' : 'site-page',
  nodeType ? `page-type-${nodeType.replace(/_/g, '-')}` : '',
]
  .filter(Boolean)
  .join(' ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Vani theme fonts, icons, and stylesheets -->
    <link rel="stylesheet" href="/themes/vani/css/font.css" />
    <link rel="stylesheet" href="/themes/vani/css/font-awesome.css" />
    <link rel="stylesheet" href="/themes/vani/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="/libraries/bootstrap-languages/languages.css" />
    <link rel="stylesheet" href="/themes/vani/css/style.css" />
    <link rel="stylesheet" href="/themes/vani/css/custom.css" />

    <!-- Canonical + Open Graph -->
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- RSS feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={new URL('/rss.xml', Astro.site ?? site.url)}
    />

    <link rel="icon" type="image/png" href={site.favicon} />
    <title>{pageTitle}</title>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class={bodyClasses}>
    <NavBar lang={lang} isFront={isFront} pageTitle={title} />

    <slot name="highlighted" />
    <slot name="content_home" />

    <div id="main-wrapper" class="main-wrapper">
      <div class="container">
        <div class="main-container">
          <main id="main" class="page-content">
            <a id="main-content" tabindex="-1"></a>
            <div class="node-content">
              <div class="region region-content">
                <slot />
              </div>
            </div>
          </main>
        </div>
      </div>
    </div>

    <Footer lang={lang} />
  </body>
</html>
