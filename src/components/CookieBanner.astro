---
import { localizeUrl, type LangCode } from '../data/site';

interface Props {
  lang?: LangCode;
}

const { lang = 'en' } = Astro.props;
const privacyUrl = localizeUrl('/privacy-policy', lang);

const heading =
  lang === 'el'
    ? 'Χρησιμοποιούμε cookies σε αυτόν τον ιστότοπο για να βελτιώσουμε την εμπειρία σας'
    : 'We use cookies on this site to enhance your user experience';

const text =
  lang === 'el'
    ? 'Κάνοντας κλικ στο κουμπί Αποδοχή, συμφωνείτε με τη χρήση τους.'
    : 'By clicking the Accept button, you agree to us doing so.';

const moreInfoLabel = lang === 'el' ? 'Περισσότερες πληροφορίες' : 'More info';
const acceptLabel = lang === 'el' ? 'Αποδοχή' : 'Accept';
const rejectLabel = lang === 'el' ? 'Όχι, ευχαριστώ' : 'No, thanks';
---

<div
  id="sliding-popup"
  class="sliding-popup-bottom"
  role="region"
  aria-label={lang === 'el' ? 'Ειδοποίηση cookies' : 'Cookie consent banner'}
  hidden
>
  <div class="eu-cookie-compliance-banner eu-cookie-compliance-banner-info eu-cookie-compliance-banner--opt-in">
    <div class="popup-content info eu-cookie-compliance-content">
      <div id="popup-text" class="eu-cookie-compliance-message" role="document">
        <h2>{heading}</h2>
        <p>{text}</p>
        <a href={privacyUrl} class="find-more-button eu-cookie-compliance-more-button">
          {moreInfoLabel}
        </a>
      </div>
      <div id="popup-buttons" class="eu-cookie-compliance-buttons">
        <button
          type="button"
          id="eu-cookie-agree-btn"
          class="agree-button eu-cookie-compliance-default-button"
        >
          {acceptLabel}
        </button>
        <button
          type="button"
          id="eu-cookie-decline-btn"
          class="decline-button eu-cookie-compliance-secondary-button"
        >
          {rejectLabel}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var COOKIE_NAME = 'cookie-agreed';
    var COOKIE_LIFETIME_DAYS = 100;

    function getCookie(name) {
      var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : null;
    }

    function setCookie(name, value, days) {
      var date = new Date();
      date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
      document.cookie =
        name + '=' + encodeURIComponent(value) + '; expires=' + date.toUTCString() + '; path=/; SameSite=Lax';
    }

    function loadMatomo() {
      if (window.__matomoLoaded) return;
      window.__matomoLoaded = true;
      var _mtm = (window._mtm = window._mtm || []);
      _mtm.push({ 'mtm.startTime': new Date().getTime(), event: 'mtm.Start' });
      var d = document,
        g = d.createElement('script'),
        s = d.getElementsByTagName('script')[0];
      g.async = true;
      g.src = 'https://site-analytics.nlpli.ilsp.gr/js/container_zRjII776.js';
      s.parentNode.insertBefore(g, s);
    }

    var status = getCookie(COOKIE_NAME);
    var popup = document.getElementById('sliding-popup');
    var agreeBtn = document.getElementById('eu-cookie-agree-btn');
    var declineBtn = document.getElementById('eu-cookie-decline-btn');

    if (status === '2') {
      loadMatomo();
    } else if (status !== '0' && popup) {
      popup.hidden = false;
    }

    if (agreeBtn) {
      agreeBtn.addEventListener('click', function () {
        setCookie(COOKIE_NAME, '2', COOKIE_LIFETIME_DAYS);
        if (popup) popup.hidden = true;
        loadMatomo();
      });
    }

    if (declineBtn) {
      declineBtn.addEventListener('click', function () {
        setCookie(COOKIE_NAME, '0', COOKIE_LIFETIME_DAYS);
        if (popup) popup.hidden = true;
      });
    }
  })();
</script>
