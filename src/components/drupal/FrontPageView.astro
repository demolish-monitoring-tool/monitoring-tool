---
import BaseLayout from '../../layouts/BaseLayout.astro';
import blocksData from '../../data/blocks.json';
import blocksWithIconData from '../../data/nodes/blocks_with_icon.json';
import { localizeUrl, site, type LangCode } from '../../data/site';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;

const logosBlock = blocksData.blocks.find((b) => b.id === 2 && b.langcode === 'en');
const impactBlock =
  lang === 'el'
    ? blocksData.blocks.find((b) => b.id === 5 && b.langcode === 'el')
    : blocksData.blocks.find((b) => b.id === 3 && b.langcode === 'en');

const impactTitle =
  lang === 'el' ? 'Επιστημονικός και κοινωνικός αντίκτυπος' : 'Scientific and social impact';

const rawImpactHtml = impactBlock?.body ?? '';
const localizedImpactHtml =
  lang === 'el'
    ? rawImpactHtml.replace('href="/project/demolish-in-brief"', 'href="/el/project/demolish-in-brief"')
    : rawImpactHtml;

const iconCards = [...(blocksWithIconData[lang] ?? blocksWithIconData.en)].sort(
  (a, b) => Number(a.ordering ?? 99) - Number(b.ordering ?? 99),
);
---

<BaseLayout title={site.name} lang={lang} isFront={true}>
  <div class="highlighted" slot="highlighted">
    <div class="container">
      <div class="region region-highlighted">
        <div id="block-vani-logos-2" class="block block-block-content">
          <div class="block-content" set:html={logosBlock?.body ?? ''} />
        </div>
      </div>
    </div>
  </div>

  <div class="homepage-content" slot="content_home">
    <div class="region region-content-home">
      <div class="views-element-container block block-views block-views-blockfront-page-blocks-block-1" id="block-vani-views-block-front-page-blocks-block-1">
        <div class="container">
          <div class="block-content">
            <div class="home-block view view-front-page-blocks view-id-front_page_blocks view-display-id-block_1">
              <div class="view-content">
                {
                  iconCards.map((card) => (
                    <div class="views-row">
                      <div class="views-field views-field-nothing">
                        <span class="field-content">
                          <div class="item">
                            <div class="service">
                              <div>
                                {card.svg_icon && (
                                  <img
                                    src={card.svg_icon.url}
                                    width="100"
                                    height="100"
                                    alt={card.title}
                                  />
                                )}
                              </div>
                              <h3>{card.title}</h3>
                              <div set:html={card.body} />
                              {card.block_item_redirect_to && (
                                <span class="button-link">
                                  <a href={localizeUrl(card.block_item_redirect_to.url, lang)}>
                                    {lang === 'el' && card.block_item_redirect_to.title === 'Read more'
                                      ? 'Περισσότερα'
                                      : card.block_item_redirect_to.title || 'Read more'}
                                  </a>
                                </span>
                              )}
                            </div>
                          </div>
                        </span>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="block-vani-scientificandorsocialimpact-2" class="block block-block-content">
        <div class="home-block-cicle1"></div>
        <div class="home-block-cicle2"></div>
        <div class="home-block-cicle3"></div>
        <div class="container">
          <h2 class="block-title">{impactTitle}</h2>
          <div class="block-content" set:html={localizedImpactHtml} />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
