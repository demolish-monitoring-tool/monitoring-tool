---
import BaseLayout from '../../layouts/BaseLayout.astro';
import newsData from '../../data/nodes/news.json';
import { type LangCode } from '../../data/site';

interface Props {
  nid: number;
  lang: LangCode;
}

const { nid, lang } = Astro.props;

const langNodes = newsData[lang] ?? [];
const enNodes = newsData.en ?? [];
const item = langNodes.find((n) => n.nid === nid) ?? enNodes.find((n) => n.nid === nid);

if (!item) {
  throw new Error(`News node nid=${nid} not found`);
}

const bodyHtml = (item.body ?? '').replace(
  /src="\/files\/([^"]+)"/g,
  'src="/files/$1" onerror="if(!this.dataset.triedProd){this.dataset.triedProd=\'1\';this.src=\'https://demolish.gr/sites/default/files/$1\';}"',
);
---

<BaseLayout title={item.title} lang={lang} nodeType="news">
  <article class="node node--type-news node--view-mode-full">
    <div class="node-content">
      {
        item.news_image ? (
          <div class="field field--name-field-news-image field--type-image field--label-hidden field__item">
            <img
              src={item.news_image.url}
              width="220"
              height="220"
              alt={item.news_image.alt || item.title}
              onerror={`if(!this.dataset.triedProd){this.dataset.triedProd='1';this.src='https://demolish.gr/sites/default${item.news_image.url}';}`}
            />
          </div>
        ) : (
          <div class="field field--name-field-news-image field--type-image field--label-hidden field__item" />
        )
      }
      <div
        class="field field--name-body field--type-text-with-summary field--label-hidden field__item"
        set:html={bodyHtml}
      />
      {
        item.attached_files && item.attached_files.length > 0 && (
          <div class="field field--name-field-attached-files field--type-file field--label-above">
            <div class="field__label">{lang === 'el' ? 'Συνημμένα αρχεία' : 'Attached files'}</div>
            <div class="field__items">
              {item.attached_files.map((file) => (
                <div class="field__item">
                  <span class="file">
                    <a href={file.url} target="_blank" rel="noopener noreferrer">
                      {file.description || file.filename}
                    </a>
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

