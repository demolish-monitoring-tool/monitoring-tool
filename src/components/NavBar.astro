---
import menusData from '../data/menus.json';
import { getLanguageSwitchUrls, localizeUrl, type LangCode } from '../data/site';

interface Props {
  lang?: LangCode;
  isFront?: boolean;
  pageTitle?: string;
}

const { lang = 'en', isFront = false, pageTitle = '' } = Astro.props;

const pathname = Astro.url.pathname;
const switchUrls = getLanguageSwitchUrls(pathname);
const homeUrl = lang === 'el' ? '/el' : '/';
const searchAction = lang === 'el' ? '/el/search' : '/search';

interface MenuItem {
  id: number | string;
  title: string;
  url: string;
  enabled: boolean;
  expanded: boolean;
  weight: number;
  children?: MenuItem[];
}

const rawMenu = (menusData.trees[lang]?.main ?? menusData.trees.en.main) as unknown as MenuItem[];
const menuItems = rawMenu
  .filter((item) => item.enabled)
  .map((item) => ({
    ...item,
    href: localizeUrl(item.url, lang),
    children: (item.children ?? [])
      .filter((child) => child.enabled)
      .map((child) => ({
        ...child,
        href: localizeUrl(child.url, lang),
      })),
  }));

const isActive = (href: string): boolean => {
  if (!href || href === '#') return false;
  const normPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;
  const normHref = href.endsWith('/') && href.length > 1 ? href.slice(0, -1) : href;
  return normPath === normHref;
};
---

<header class="header">
  <div class="header-cicle header-cicle1"></div>
  <div class="header-cicle header-cicle3"></div>
  <div class="header-cicle header-cicle4"></div>
  <div class="header-cicle header-cicle6"></div>
  <div class="header-cicle header-cicle7"></div>
  <div class="header-cicle header-cicle8"></div>
  <div class="header-cicle header-cicle10"></div>
  {
    isFront && (
      <>
        <div class="header-cicle header-cicle2"></div>
        <div class="header-cicle header-cicle5"></div>
        <div class="header-cicle header-cicle9"></div>
      </>
    )
  }
  <div class="container">
    <div class="header-main">
      <div class="site-brand">
        <div class="site-branding">
          <div class="site-logo">
            <a href={homeUrl} title="Home" rel="home">
              <img src="/files/path_newFont_bold.png" alt="Home" />
            </a>
          </div>
        </div>
      </div>
      <div class="header-main-right">
        <div class="mobile-menu"><i class="icon-menu"></i></div>
        <div class="primary-menu-wrapper">
          <div class="menu-wrap">
            <div class="close-mobile-menu">x</div>
            <div class="region region-primary-menu">
              {/* Language switcher (uncomment to re-enable)
              <div
                class="language-switcher-language-url block block-languages-dropdown"
                id="block-vani-languageswitcherbootstrap"
              >
                <div class="block-content">
                  <div class="btn-group">
                    <button
                      class="btn btn-default dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      aria-label="Select language"
                    >
                      <span class="lang-sm" lang={lang}></span>
                    </button>
                    <ul class="dropdown-menu" role="menu">
                      <li>
                        <a href={switchUrls.en}>
                          <span class="lang-sm lang-lbl" lang="en"></span>
                        </a>
                      </li>
                      <li>
                        <a href={switchUrls.el}>
                          <span class="lang-sm lang-lbl" lang="el"></span>
                        </a>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              */}

              <nav role="navigation">
                <ul class="main-menu">
                  {
                    menuItems.map((item) => {
                      const hasChildren = item.children && item.children.length > 0;
                      const active =
                        isActive(item.href) ||
                        (hasChildren && item.children.some((c) => isActive(c.href)));
                      return (
                        <li
                          class:list={[
                            'main-menu-item',
                            { expanded: hasChildren, 'is-active': active },
                          ]}
                        >
                          <a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]}>
                            {item.title}
                            {hasChildren && <span class="dropdown-arrow">+</span>}
                          </a>
                          {hasChildren && (
                            <ul class="submenu">
                              {item.children.map((child) => (
                                <li class="main-menu-item-sub">
                                  <a
                                    href={child.href}
                                    class:list={[{ 'is-active': isActive(child.href) }]}
                                  >
                                    {child.title}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      );
                    })
                  }
                </ul>
              </nav>
            </div>
          </div>
        </div>
        <div class="full-page-search">
          <div class="search-icon">
            <a href="#" aria-label="Open search"><img src="/themes/vani/images/search.svg" alt="search icon" /></a>
          </div>
          <div class="search-box">
            <div class="search-box-close"></div>
            <div class="search-box-content">
              <div class="region region-search-box">
                <div class="block">
                  <h2 class="block-title">{lang === 'el' ? 'Αναζήτηση' : 'Search'}</h2>
                  <form action={searchAction} method="get" class="views-exposed-form" accept-charset="UTF-8">
                    <div class="form-item">
                      <input
                        placeholder={lang === 'el' ? 'Αναζήτηση...' : 'Enter your keywords'}
                        type="text"
                        name="search_api_fulltext"
                        value=""
                        size="30"
                        maxlength="128"
                        class="form-text"
                      />
                    </div>
                    <div class="form-actions">
                      <input type="submit" value={lang === 'el' ? 'Αναζήτηση' : 'Search'} class="button form-submit" />
                    </div>
                  </form>
                </div>
              </div>
            </div>
            <div class="search-box-close"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {
    isFront ? (
      <section class="slider">
        <div class="container slider-container">
          <div class="slider-text">
            <ul class="js-rotating">
              <li>
                <h1>
                  Fighting Bias, Building Bridges. The <em>DeMoLiSH</em> project
                </h1>
                <p>
                  DeMoLiSH is an innovative, multidisciplinary research project addressing hate
                  speech and xenophobia in Greece expressed online via social media and offline in
                  real-life behavior from 2015 to 2022 that covers a variety of socio-economic
                  contexts ranging from the economic to the refugee and the pandemic crisis.
                </p>
                <a class="button-link" href={localizeUrl('/project/demolish-in-brief', lang)}>
                  {lang === 'el' ? 'Μάθετε περισσότερα' : 'Find out more'}
                </a>
              </li>
            </ul>
          </div>
          <div class="slider-image">
            <img src="/files/undraw_team_up_re_84ok.svg" alt="slider image" />
          </div>
        </div>
        <div class="slider-svg">
          <img src="/themes/vani/images/slider.svg" alt="svg" />
        </div>
      </section>
    ) : (
      <div id="page-header">
        <div class="container">
          <h1 class="page-title">{pageTitle}</h1>
          <nav class="breadcrumb" role="navigation" aria-label="Breadcrumb">
            <ol class="breadcrumb-items">
              <li class="breadcrumb-item">
                <a href={homeUrl}>{lang === 'el' ? 'Αρχική' : 'Home'}</a>
              </li>
              {pageTitle && (
                <li class="breadcrumb-item">
                  <span>{pageTitle}</span>
                </li>
              )}
            </ol>
          </nav>
        </div>
      </div>
    )
  }
</header>
