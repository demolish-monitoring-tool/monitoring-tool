---
import WorkPackageNodeView from '../../../components/drupal/WorkPackageNodeView.astro';
import workPackagesData from '../../../data/nodes/work_packages.json';

export function getStaticPaths() {
  return (workPackagesData.en ?? []).map((wp) => ({
    params: { wp: wp.slug },
    props: { nid: wp.nid },
  }));
}

interface Props {
  nid: number;
}

const { nid } = Astro.props;
---

<WorkPackageNodeView nid={nid} lang="el" />

